{
  "manifest_version": 3,
  "name": "Step Solver",
  "version": "2.0.1",
  "description": "Live AI solver for StepTest and online assessments, MCQs, sentence rearrangement, and writing questions powered by Gemini AI.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Step Solver Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png",
      "300": "icons/icon300.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://english.steptest.in/*"],
      "js": ["page_protection.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://english.steptest.in/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.youtube.com/embed/*",
        "*://youtube.com/embed/*",
        "*://*.youtube-nocookie.com/embed/*",
        "*://youtube-nocookie.com/embed/*",
        "*://*.youtube.com/v/*",
        "*://youtube.com/v/*"
      ],
      "js": ["youtube_loop.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "300": "icons/icon300.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "page_protection.js", "youtube_loop.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "solve_current_question": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Scan and solve the current on-screen question"
    },
    "toggle_hud": {
      "suggested_key": {
        "default": "Alt+H",
        "mac": "Alt+H"
      },
      "description": "Toggle the floating assistant widget"
    }
  }
}
